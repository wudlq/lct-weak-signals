# Скопируйте в .env и подставьте свои значения. Сам .env в репозиторий не коммитим.

# Бесплатный ключ OpenAlex: openalex.org/settings/api (регистрация занимает минуту)
OPENALEX_KEY=

# Почта для вежливого пула OpenAlex — необязательно, но ответы стабильнее
OPENALEX_MAILTO=

# Путь к базе. По умолчанию data/signals.db рядом с проектом.
SIGNALS_DB=data/signals.db
