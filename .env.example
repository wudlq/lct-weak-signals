# Скопируйте в .env и подставьте свои значения. Сам .env в репозиторий не коммитим.

# Бесплатный ключ OpenAlex: openalex.org/settings/api (регистрация занимает минуту)
OPENALEX_KEY=

# Ключ для базы патентов PatentsView (выдается по заявке через хелп-центр)
PATENTSVIEW_KEY=

# Почта для вежливого пула OpenAlex — необязательно, но ответы стабильнее
OPENALEX_MAILTO=

# Путь к базе. По умолчанию data/signals.db рядом с проектом.
SIGNALS_DB=data/signals.db

# Языковая модель для русских текстов в карточке.
# Пусто или none — система работает без неё, тексты остаются как в источниках.
# Допустимые значения: gigachat | yandex | openai | mock
LLM_PROVIDER=

# GigaChat 2
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2-Pro
# Домены Сбера подписаны корневым сертификатом НУЦ Минцифры. Обычно ничего
# указывать не нужно: файл лежит в certs/russian_trusted_ca.pem, а если его нет —
# скачайте командой  bash scripts/install_ru_certs.sh
# Переменная нужна только чтобы указать сертификат в другом месте.
GIGACHAT_CA_BUNDLE=

# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# gpt-4.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
